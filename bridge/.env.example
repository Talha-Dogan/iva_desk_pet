# Bu dosyayi .env olarak kopyala ve kendi degerlerini yaz.
# .env dosyasi .gitignore'da; asla commit etme.

# xiaozhi.me konsolu -> Extensions -> MCP Endpoint adresi (token dahil)
MCP_ENDPOINT=

# Telegram: @BotFather -> /newbot ile alinan token
TELEGRAM_BOT_TOKEN=

# Telegram sohbet/grup kimligi
# Botu gruba ekle, gruba "/start@botadi" yaz, sonra:
# https://api.telegram.org/bot<TOKEN>/getUpdates adresinden "chat":{"id":...} degerini al
TELEGRAM_CHAT_ID=

# Gunluk not ozetinin Telegram'a gonderilecegi saat (0-23)
DIGEST_HOUR=21
